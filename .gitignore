# Node / TypeScript build artifacts
node_modules/
dist/
*.tsbuildinfo

# Env files
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Claude Code local overrides (per-machine)
.claude/settings.local.json

# Per-machine rendered hook config (paths). Render via scripts/install-user.ps1
# from .claude/settings.template.json.
.claude/settings.json

# Dev verification logs/reports (May 2026 bring-up)
.verify-stream.log
.verify-prompt.txt
verification-report*.md

# Harness per-run artifacts (written locally by /pp:run)
.harness/runs/
.harness/run_*/

# Attended-run worktrees: Hydra provisions these under .harness/worktrees/
# (not the obsolete .claude/worktrees/ below) for host-bridged attended
# engineering stages. Local, per-machine, and can outlive a single session
# (a run can pause on HITL for days) — never meant to be tracked.
.harness/worktrees/

# Judge critique-failure evidence, TDD/browser baseline captures, and smoke
# check output — all local, per-run artifacts, not source.
.harness/critique_failures/
.harness/baseline/
.harness/smoke/

# Ephemeral best-of-N candidate worktrees
.claude/worktrees/

# Lock file written by scheduled-task subsystem
.claude/scheduled_tasks.lock

# Hydra workflow trace/checkpoint state (per-machine, not source)
.hydra/
