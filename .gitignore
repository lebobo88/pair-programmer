# Node / TypeScript build artifacts
node_modules/
dist/
*.tsbuildinfo

# Env files
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Claude Code local overrides (per-machine)
.claude/settings.local.json

# Per-machine rendered hook config (paths). Render via scripts/install-user.ps1
# from .claude/settings.template.json.
.claude/settings.json

# Dev verification logs/reports (May 2026 bring-up)
.verify-stream.log
.verify-prompt.txt
verification-report*.md

# Harness per-run artifacts (written locally by /pp:run)
.harness/runs/

# Ephemeral best-of-N candidate worktrees
.claude/worktrees/

# Lock file written by scheduled-task subsystem
.claude/scheduled_tasks.lock

# ─── Ecosystem overlay (per-machine; regenerate via scripts/link-ecosystem.ps1) ───
# Sibling-contributed agents/skills/squads are NOT committed — they are materialized
# locally as symlinks (or copies) from adjacent sibling repos, resolved dynamically via
# PP_CONSUMER_BASE / PP_ECOSYSTEM_ROOT / parent-of-clone. Names come from .harness/ecosystem.json.
# Regenerate this block from .harness/.ecosystem-links.local.json after adding a sibling.
.harness/.ecosystem-links.local.json
