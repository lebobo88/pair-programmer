{
  "_comment": "Project-scoped MCP servers (alternate location). Claude Code launches these with cwd=<project root>, so the relative path resolves correctly after `cd daemon && npm install && npm run build`.",
  "mcpServers": {
    "pp_harness": {
      "type": "stdio",
      "command": "node",
      "args": [
        "daemon/dist/index.js",
        "mcp"
      ],
      "env": {}
    },
    "pp_codex": {
      "type": "stdio",
      "command": "node",
      "args": [
        "daemon/dist/index.js",
        "mcp-codex"
      ],
      "env": {}
    },
    "pp_agy": {
      "type": "stdio",
      "command": "node",
      "args": [
        "daemon/dist/index.js",
        "mcp-agy"
      ],
      "env": {}
    }
  }
}
